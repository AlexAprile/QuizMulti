<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/backgroung_shrek"
        android:scaleType="centerCrop"
        android:layout_gravity="center"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:orientation="vertical"
        android:gravity="center">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0">


        <TextView
            android:id="@+id/tvRisposteCorretteValide"
            android:text="Risposte corrette: X"
            android:textSize="@dimen/textsize_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:textColor="@color/black"
            />


        <TextView
            android:id="@+id/tvRisposteNonValide"
            android:text="Risposte corrette non valide: X"
            android:textSize="@dimen/textsize_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:textColor="@color/black"
            />


        <TextView
            android:id="@+id/tvRisposteErrate"
            android:text="Risposte da Ciuchino: X"
            android:textSize="@dimen/textsize_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:textColor="@color/black"
            />

        <!--
        <TextView
            android:id="@+id/tvRisposteTotali"
            android:text="Risposte Totali: X"
            android:textSize="@dimen/textsize_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:textColor="@color/black"
            />
        -->
    </LinearLayout>

    <TextView
        android:id="@+id/numeroQuesito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="Quesito n: 1"
        android:textSize="@dimen/textsize_big"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"
        />

    <TextView
        android:id="@+id/tvDomanda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/llPulsanti"
        android:layout_centerInParent="true"
        android:text="Domanda"
        android:textSize="@dimen/textsize_big"
        android:layout_marginBottom="@dimen/margin"
        android:gravity="center"
        android:layout_weight="2"
        android:textColor="@color/white"
        android:background="@color/light_brown"
        />


    <LinearLayout
        android:id="@+id/llPulsanti"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center|bottom"
        android:layout_weight="4">

        <Button
            android:id="@+id/tvRisposta1"
            android:onClick="rispostaClicked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risposta1"
            android:textSize="@dimen/textsize_big"
            android:textColor="@color/white"
            android:backgroundTint="@color/brown"
            android:layout_weight="2"
            />

        <Button
            android:id="@+id/tvRisposta2"
            android:onClick="rispostaClicked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risposta2"
            android:textSize="@dimen/textsize_big"
            android:textColor="@color/dark_green"
            android:backgroundTint="@color/white"
            android:layout_weight="2"
            />

        <Button
            android:id="@+id/tvRisposta3"
            android:onClick="rispostaClicked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Risposta3"
            android:textSize="@dimen/textsize_big"
            android:textColor="@color/white"
            android:backgroundTint="@color/brown"
            />

        <Button
            android:id="@+id/tvRisposta4"
            android:onClick="rispostaClicked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risposta4"
            android:textSize="@dimen/textsize_big"
            android:textColor="@color/dark_green"
            android:backgroundTint="@color/white"
            android:layout_weight="2"
            />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center|bottom"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/margin_button"
                android:onClick="precedenteClicked"
                android:text="PREC"
                android:textSize="@dimen/textsize_big"
                android:textColor="@color/white"
                android:backgroundTint="@color/dark_green"
                android:layout_weight="1"
                />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"></FrameLayout>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="successivoClicked"
                android:text="SUCC"
                android:textSize="@dimen/textsize_big"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:backgroundTint="@color/dark_green"
                />
        </LinearLayout>


        <Button
            android:id="@+id/buttonSuggerimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:onClick="suggerimentoClicked"
            android:text="Suggerimento"
            android:textSize="@dimen/textsize_big"
            android:textColor="@color/brown"
            android:backgroundTint="@color/greenOrc"
            />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/buttonSuggerimento"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:onClick="resetClicked"
            android:text="Reset"
            android:textSize="@dimen/textsize_big"
            android:textColor="@color/white"
            android:backgroundTint="@color/red"
            />


    </LinearLayout>

    </LinearLayout>

</FrameLayout>